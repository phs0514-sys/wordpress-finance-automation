# Copy to .env locally; never commit real values.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_REASONING=medium
OPENAI_WRITING_MODEL=gpt-5.6-terra
OPENAI_WRITING_REASONING=medium

# Optional read-only Google Search Console bearer tokens. Leave blank when GSC
# is not connected; reports will label Query/page/country/device metrics as
# unavailable instead of treating them as zero.
GSC_TOKEN=
GSC_SITE_URL=
GSC_US_TOKEN=
GSC_JP_TOKEN=
GSC_KR_TOKEN=

# WordPress.com Free sites use the public REST API plus an OAuth2 bearer token.
# WP_*_ACCESS_TOKEN may be filled directly, or leave it blank and fill the
# client fields plus an Application Password for a password-grant exchange.
WP_US_URL=https://usfinanceresearch.wordpress.com
WP_US_MODE=wpcom
WP_US_SITE_REF=usfinanceresearch.wordpress.com
WP_US_USERNAME=
WP_US_APPLICATION_PASSWORD=
WP_US_CLIENT_ID=
WP_US_CLIENT_SECRET=
WP_US_ACCESS_TOKEN=
WP_JP_URL=https://jpfinanceresearch.wordpress.com
WP_JP_MODE=wpcom
WP_JP_SITE_REF=jpfinanceresearch.wordpress.com
WP_JP_USERNAME=
WP_JP_APPLICATION_PASSWORD=
WP_JP_CLIENT_ID=
WP_JP_CLIENT_SECRET=
WP_JP_ACCESS_TOKEN=
WP_KR_URL=https://koreafinanceresearch.wordpress.com
WP_KR_MODE=wpcom
WP_KR_SITE_REF=koreafinanceresearch.wordpress.com
# KR inherits the US account/application credentials unless KR-specific values are set.
WP_KR_USERNAME=
WP_KR_APPLICATION_PASSWORD=
WP_KR_CLIENT_ID=
WP_KR_CLIENT_SECRET=
WP_KR_ACCESS_TOKEN=

# draft is the safe initial mode. Change to publish only after a manual test.
PUBLISH_MODE=draft
# Soft content target: 85+ auto-publish; 78–84 gets one targeted revision;
# hard truth/technical gates can still hold any score.
QUALITY_THRESHOLD=85
MAX_REVISIONS=4
DAILY_POSTS_PER_LOCALE=1
PUBLISH_HEALTH_GATE=1
PUBLISH_FORCE_RESUME=0
FINAL_FACT_REVIEW=1

